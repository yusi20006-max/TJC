#!/data/data/com.termux/files/usr/bin/sh
set -eu
SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$LINK_TARGET" ;;
  esac
done
BASE_DIR=$(CDPATH="" cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
# shellcheck disable=SC1091
. "$BASE_DIR/lib/colors.sh"
# shellcheck disable=SC1091
. "$BASE_DIR/lib/utils.sh"
# shellcheck disable=SC1091
. "$BASE_DIR/lib/output.sh"
# shellcheck disable=SC1091
. "$BASE_DIR/lib/config.sh"
# shellcheck disable=SC1091
. "$BASE_DIR/lib/logger.sh"
# shellcheck disable=SC1091
. "$BASE_DIR/lib/provider.sh"
COMMAND="${1:-help}"
case "$COMMAND" in
  help|-h|--help) . "$BASE_DIR/commands/help.sh"; tjc_help "$BASE_DIR" ;;
  version|-v|--version) . "$BASE_DIR/commands/version.sh"; tjc_version "$BASE_DIR" ;;
  workflow) . "$BASE_DIR/commands/workflow.sh"; [ "$#" -gt 0 ] && shift; tjc_workflow "$@" ;;
  schedule) . "$BASE_DIR/commands/schedule.sh"; [ "$#" -gt 0 ] && shift; tjc_schedule "$@" ;;
  job) . "$BASE_DIR/commands/job.sh"; [ "$#" -gt 0 ] && shift; tjc_job_command "$@" ;;
  queue) . "$BASE_DIR/commands/queue.sh"; [ "$#" -gt 0 ] && shift; tjc_queue_command "$@" ;;
  mcp) . "$BASE_DIR/commands/mcp.sh"; [ "$#" -gt 0 ] && shift; tjc_mcp_command "$@" ;;
  *) tjc_error "Unknown command: $COMMAND"; . "$BASE_DIR/commands/help.sh"; tjc_help "$BASE_DIR"; exit 1 ;;
esac
